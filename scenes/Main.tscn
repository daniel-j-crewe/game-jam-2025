[node name="CoolWizard001" parent="." node_paths=PackedStringArray("map") instance=ExtResource("2_3wkso")]
position = Vector2(98, 60)
BoostedSpeed = 200.0
map = NodePath("../Layer0")
StartPos = Vector2(-22, 52)
SpawnedTowerMovementVelocity = 100.0
SpawnedTowerTimeToLive = 10.0
SpawnedTowerRateOfFire = 1.25
DeathTexts = PackedStringArray("Back again, and so it goes.", "I\'m getting sick of this damn place.", "*sigh*", "I miss my wife.", "Damn that hurt.", "When will this end?", "I\'m never going to get out, am I?", "All these deaths are beginning to blur together.", "Why do bad things happen to good people?", "Better get back on that metaphorical horse...", "Mother was right, I should\'ve been a doctor.", "Was I meant to go left there, or right? Does it matter?", "Pain is in the mind, like fear, or suffering, and other hateful things.", "If I see another skeleton I\'m going to lose my composure.", "Sunlight. You don\'t miss it until its gone.", "Maybe I should stay dead next time.", "This will not be my tomb!", "For some reason I\'m craving pancakes.", "Is that a saxophone I\'m hearing?", "If I still had spell slots I\'d be out of here by now.", "Wait a minute, is the floor purple?", "This is why you never split the party.", "So... this is just my home now.", "Maker, can you hear me? No, of course not. Stupid idea.", "If I still could, I\'d be crying right now. ", "I\'ve made it through worse. Not much worse, but still.", "Every time I\'m back here, a little part of me dies.", "**** this!", "Okay, I\'m ready to leave now, please.", "Tomorrow, and tomorrow, and tomorrow...")

